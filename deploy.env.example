# Copy to deploy.env (git-ignored) and fill in.
# DEPLOY_HOST can be an ssh alias from ~/.ssh/config (e.g. periscope-prod) or an IP.
DEPLOY_HOST=
DEPLOY_USER=
DEPLOY_PORT=22
# PHP binary used for artisan on the server (e.g. php8.3)
REMOTE_PHP=php
# Absolute paths on the server
API_PATH=/var/www/periscope/api
APP_PATH=/var/www/periscope/app
ADMIN_PATH=/var/www/periscope/admin
